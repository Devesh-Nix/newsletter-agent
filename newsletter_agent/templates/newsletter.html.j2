<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">{{ preheader }}&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f4f6;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:640px;background-color:#ffffff;border-radius:14px;overflow:hidden;">

        <!-- Masthead -->
        <tr>
          <td style="background-color:#111827;padding:30px 36px 28px;">
            <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.4;letter-spacing:2px;text-transform:uppercase;color:#a5b4fc;">Weekly &middot; {{ period_label }}</p>
            <h1 style="margin:8px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:1.2;font-weight:700;color:#ffffff;">{{ newsletter_name }}</h1>
          </td>
        </tr>

        <!-- Intro -->
        <tr>
          <td style="padding:30px 36px 6px;">
            <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.65;color:#1f2937;">{{ intro }}</p>
          </td>
        </tr>

        <!-- In this issue -->
        <tr>
          <td style="padding:20px 36px 8px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef2ff;border-radius:10px;">
              <tr>
                <td style="padding:18px 22px;">
                  <p style="margin:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#4338ca;">In this issue</p>
                  {% for item in items %}
                  <p style="margin:0 0 4px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#1f2937;"><span style="color:#6366f1;font-weight:700;">{{ loop.index }}.</span>&nbsp; {{ item.headline }}</p>
                  {% endfor %}
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Stories -->
        {% for item in items %}
        <tr>
          <td style="padding:26px 36px 24px;{% if not loop.first %}border-top:1px solid #e5e7eb;{% endif %}">
            <p style="margin:0 0 10px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:1;"><span style="display:inline-block;padding:5px 10px;border-radius:999px;background-color:#eef2ff;color:#4338ca;font-weight:700;letter-spacing:1px;text-transform:uppercase;">{{ item.category }}</span></p>
            <h2 style="margin:0 0 6px;font-family:Georgia,'Times New Roman',serif;font-size:21px;line-height:1.3;font-weight:700;"><a href="{{ item.url }}" style="color:#111827;text-decoration:none;">{{ item.headline }}</a></h2>
            <p style="margin:0 0 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.4;color:#6b7280;">{{ item.source }} &middot; {{ item.date_label }}</p>
            <p style="margin:0 0 14px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{ item.summary }}</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="border-left:3px solid #6366f1;padding:2px 0 2px 14px;">
                  <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#1f2937;"><strong style="color:#4338ca;">Why it matters:</strong> {{ item.why_it_matters }}</p>
                </td>
              </tr>
            </table>
            <p style="margin:14px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;"><a href="{{ item.url }}" style="color:#4f46e5;font-weight:700;text-decoration:none;">Read the full story &rarr;</a></p>
          </td>
        </tr>
        {% endfor %}

        <!-- The big picture -->
        <tr>
          <td style="padding:8px 36px 24px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#111827;border-radius:12px;">
              <tr>
                <td style="padding:22px 26px;">
                  <p style="margin:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#a5b4fc;">The big picture</p>
                  <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.65;color:#f9fafb;">{{ big_picture }}</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Sign-off -->
        <tr>
          <td style="padding:4px 36px 30px;">
            <p style="margin:0 0 10px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.65;color:#374151;">{{ sign_off }}</p>
            <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:15px;font-style:italic;color:#111827;">&mdash; The team at {{ newsletter_name }}</p>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td style="background-color:#f9fafb;border-top:1px solid #e5e7eb;padding:20px 36px;">
            <p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#6b7280;">You're receiving this because you subscribed to {{ newsletter_name }}. <a href="{{ unsubscribe_url }}" style="color:#6b7280;">Unsubscribe</a>.<br>This issue was researched, written and self-reviewed by an autonomous AI agent. Every story links to its original source.</p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
