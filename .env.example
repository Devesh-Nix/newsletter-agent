# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# "auto" picks the first provider whose API key is set, in this order:
#   anthropic -> openai -> google_genai -> xai -> ollama (local, no key)
LLM_PROVIDER=auto

# Optional model override. Defaults per provider:
#   anthropic: claude-opus-5 | openai: gpt-6-sol | google_genai: gemini-3.8-flash
#   xai: grok-4.7 | ollama: qwen3:8b
# LLM_MODEL=

# Set the key for the provider you want to use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Research
# ---------------------------------------------------------------------------
# Optional: enables the Tavily web-search tool. Bing News, Google News and
# Hacker News work without any key.
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Agent behaviour (all optional)
# ---------------------------------------------------------------------------
# NEWSLETTER_NAME=The Agentic Brief
# LOOKBACK_DAYS=7
# MIN_ARTICLES=5
# MAX_ARTICLES=7
# MAX_RESEARCH_ROUNDS=3
# MAX_REVISIONS=2
# QUALITY_THRESHOLD=8.0
# OUTBOX_DIR=outbox
# SUBSCRIBERS_FILE=data/subscribers.json
