# Paste into Streamlit Community Cloud -> App settings -> Secrets
# (or copy to .streamlit/secrets.toml for local use; that file is gitignored).
# Every key here is exposed to the app as an environment variable.

# One LLM provider key. Gemini's Flash models are the cheapest option for a public demo.
GOOGLE_API_KEY = ""
# ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY = ""
# XAI_API_KEY = ""

# Model calls are paced automatically for Gemini (5/min, its free-tier limit).
# On a paid key, raise or disable (0) the cap:
# LLM_REQUESTS_PER_MINUTE = 0

# Optional: pin the provider/model instead of auto-detecting from the key above.
# LLM_PROVIDER = "google_genai"
# LLM_MODEL = "gemini-3.8-flash"

# Recommended for a public URL: only people you share this password with can run
# the agent on your API key.
APP_PASSWORD = ""

# Optional: enables the Tavily web-search tool.
# TAVILY_API_KEY = ""
